APP_NAME=11med
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elevenmed
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=pk_test_****************************************
PAYSTACK_SECRET_KEY=sk_test_****************************************

QUERY_LOGGER_MODE=long
QUERY_LOGGER_ENABLED=true
QUERY_LOGGER_THRESHOLD=500

# 11med identity (M2)
# Texts go to the log until SMS_ENABLED=true and the kit's gateway is configured (HT-002).
SMS_ENABLED=false
# A fixed six-digit code for staging before SMS works. Ignored when APP_ENV=production.
OTP_FIXED_CODE=
# Social sign-in: the audience each provider's ID token must carry (HT-003).
# Google: the app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (an EAS environment variable, not in the repo).
GOOGLE_WEB_CLIENT_ID=
# Apple: the app's iOS bundle identifier (11med app.json).
APPLE_BUNDLE_ID=ng.elevenmed.app
# Where portal reset and welcome emails link to: the portals' own address (11med-web), not the API's.
PORTALS_URL=http://localhost:3000
CONSENT_POLICY_VERSION=2026-07-01
