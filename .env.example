APP_NAME=11med
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elevenmed
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploads: pictures on the public disk, attachments, results and licences on the private one (HT-005).
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log, smtp or resend. With resend, set RESEND_API_KEY and a MAIL_FROM_ADDRESS on a domain verified in Resend.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (HT-007). The secret key also signs the webhook; the app never sees either key.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=elevenmed://pay
PAYMENTS_EMAIL_DOMAIN=customers.11med.ng
PAYMENTS_ABANDON_AFTER_MINUTES=60

QUERY_LOGGER_MODE=long
QUERY_LOGGER_ENABLED=true
QUERY_LOGGER_THRESHOLD=500

# 11med identity (M2)
# Texts go to the log until SMS_ENABLED=true and the kit's gateway is configured (HT-002).
SMS_ENABLED=false
# KudiSMS (HT-002); also run `php artisan dbconfig:set prefered_sms_channel KUDISMS` (docs/SETUP.md).
KUDISMS_API_KEY=
KUDISMS_SENDER_ID=
# A fixed six-digit code for staging before SMS works. Ignored when APP_ENV=production.
OTP_FIXED_CODE=
# Remote push (M7, HT-006). Logged until PUSH_ENABLED=true and a provider's credentials are set.
PUSH_ENABLED=false
# APNs: the team's .p8 key file (outside the web root), its key id and the team id.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ng.elevenmed.app
# true for App Store and TestFlight builds; false for development builds, which hold sandbox tokens.
APNS_PRODUCTION=false
# FCM: the Firebase service account JSON file (outside the web root).
FCM_CREDENTIALS_PATH=
# Social sign-in: the audience each provider's ID token must carry (HT-003).
# Google: the app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (an EAS environment variable, not in the repo).
GOOGLE_WEB_CLIENT_ID=
# Apple: the app's iOS bundle identifier (11med app.json).
APPLE_BUNDLE_ID=ng.elevenmed.app
# Where portal reset and welcome emails link to: the portals' own address (11med-web), not the API's.
PORTALS_URL=http://localhost:3000
# Browser origins allowed to call the API, comma separated; defaults to PORTALS_URL.
# CORS_ALLOWED_ORIGINS=https://portal.11med.ng
# Where an emergency QR code points, and the store link in a caregiver invitation (HT-012).
EMERGENCY_URL=https://11med.ng/profile/view
APP_DOWNLOAD_URL=https://11med.ng/app

# Compliance report PDFs (M6): a private disk, served by signed links only
REPORT_DISK=local
CONSENT_POLICY_VERSION=2026-07-01
# Two-step verification (M14): required for the team's accounts unless false.
ADMIN_2FA_REQUIRED=true
TWO_FACTOR_ISSUER=11med
# Download my data (M14): a private disk, never a public one.
DATA_EXPORT_DISK=local

# Consultations (M10). The platform's share of each fee, taken when a payout is made.
CONSULTATION_COMMISSION_PERCENT=15
# Voice and video calls (HT-008): `mock` until the Daily.co key exists, then `daily`.
CALL_PROVIDER=mock
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1

# Guide conversations idle this many days are deleted (M13, HT-130).
GUIDE_RETENTION_DAYS=30
